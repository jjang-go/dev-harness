#!/bin/sh
# 스테이징된 변경에 비밀 파일이나 비밀값이 있으면 커밋을 막는다.
# - 비밀 파일: 이 훅 옆의 secret-files 목록(.gitignore 문법)으로 항상 검사한다.
#   gitleaks는 추가된 텍스트 줄만 보므로 빈 파일·바이너리·이름만 바뀐 파일을 놓치기 때문이다.
# - 비밀값: gitleaks가 있으면 저장소 루트의 .gitleaks.toml로 검사하고,
#   없으면 아래 최소 내장 패턴으로 대신한다. 이때 .gitleaks.toml은 적용되지 않는다.

found=""
leaks=""
glerr=""

# 비밀 파일
list="$(dirname "$0")/secret-files"
if [ -f "$list" ]; then
  staged=$(mktemp) || exit 1
  trap 'rm -f "$staged"' EXIT
  trap 'exit 1' INT TERM   # 중단돼도 EXIT 트랩으로 임시 파일을 지운다
  git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMRT > "$staged"
  files=$(git -c core.quotepath=off ls-files -c -i -X "$list" | grep -Fx -f "$staged")
  [ -n "$files" ] && found="$(printf '%s\n' "$files" | sed 's/$/ (비밀 파일)/')
"
else
  echo "secret-files 목록이 없어 비밀 파일 검사를 건너뛴다: $list" >&2
fi

# 비밀값
if command -v gitleaks >/dev/null 2>&1; then
  # 비밀값 발견(3)과 실행 오류(그 밖의 0이 아닌 값)를 구분한다. 오류여도 검사를 못 했으니 막는다.
  gitleaks git --pre-commit --staged --redact --no-banner --verbose --log-level warn --exit-code 3
  rc=$?
  if [ "$rc" -eq 3 ]; then
    leaks=1
  elif [ "$rc" -ne 0 ]; then
    glerr=$rc
  fi
else
  echo "gitleaks가 없어 비밀값은 최소 내장 패턴으로만 검사한다. .gitleaks.toml은 적용되지 않는다." >&2

  # 추가된 줄만 "파일:줄: 내용" 형태로 모아 고신뢰 패턴과 대조한다.
  added=$(git -c core.quotepath=off diff --cached -U0 --no-color --diff-filter=ACMRT | awk '
    /^diff --git / { hdr = 1; next }
    hdr && /^\+\+\+ / { f = substr($0, 7); sub(/\t$/, "", f); next }   # 공백 있는 이름 뒤 탭 제거
    /^@@/ { hdr = 0; split($3, a, ","); n = substr(a[1], 2) + 0; next }
    !hdr && /^\+/ { print f ":" n ": " substr($0, 2); n++ }
  ' | grep -v 'gitleaks:allow')

  while IFS='|' read -r name regex; do
    hits=$(printf '%s\n' "$added" | grep -E -- "$regex" | cut -d: -f1,2)
    [ -n "$hits" ] && found="$found$(printf '%s\n' "$hits" | sed "s/\$/ ($name)/")
"
  done <<'EOF'
private-key|-----BEGIN ([A-Z]+ )*PRIVATE KEY
aws-access-key|(AKIA|ASIA)[0-9A-Z]{16}
github-token|(ghp|gho|ghu|ghs|ghr)_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{82}
gitlab-token|glpat-[0-9A-Za-z_-]{20}
slack-token|xox[abprs]-[0-9A-Za-z-]{10,}
google-api-key|AIza[0-9A-Za-z_-]{35}
stripe-key|(sk|rk)_live_[0-9A-Za-z]{24,}
anthropic-key|sk-ant-[0-9A-Za-z_-]{20,}
openai-key|sk-proj-[0-9A-Za-z_-]{20,}
EOF
fi

if [ -n "$glerr" ]; then
  echo "커밋 거부: gitleaks 실행 오류(종료 코드 $glerr)로 비밀값을 검사하지 못했다. gitleaks 버전이 낮거나(git 하위 명령이 없는 버전) .gitleaks.toml 문법이 틀렸을 수 있다." >&2
  [ -n "$found" ] && printf '%s' "$found" | sed 's/^/  /' >&2
  exit 1
fi

if [ -n "$found" ] || [ -n "$leaks" ]; then
  echo "커밋 거부: 비밀 파일이나 비밀값이 스테이징돼 있다." >&2
  [ -n "$found" ] && printf '%s' "$found" | sed 's/^/  /' >&2
  [ -n "$leaks" ] && echo "  (비밀값은 위 gitleaks 결과 참고)" >&2
  echo "진짜 비밀이면 스테이징을 풀고(git restore --staged <파일>) 환경 변수나 비밀 저장소로 옮긴다." >&2
  echo "오탐이면 파일은 secret-files에 ! 예외 줄을, 값은 해당 줄 끝 gitleaks:allow 주석이나 .gitleaks.toml의 [[allowlists]]를 더한다." >&2
  exit 1
fi
